<div class="color-{{ section.settings.color_scheme }}">
  <div class="page-width section section--tight">
    <div class="rich-text rich-text--center" style="margin-inline:auto;">
      <p class="eyebrow">{{ section.settings.eyebrow }}</p>
      <h1 class="h1">{{ section.settings.heading }}</h1>
      {%- if section.settings.text != blank -%}<div class="prose" style="margin-top:1rem;">{{ section.settings.text }}</div>{%- endif -%}
    </div>

    <div class="grid grid--2" style="gap:1.5rem;margin-top:2.5rem;max-width:800px;margin-inline:auto;">
      <div class="card card--pad" style="text-align:center;">
        <span class="benefit-list__icon" style="background:var(--cs-card);margin-inline:auto;">{%- render 'icon', name: 'account', size: 22 -%}</span>
        <p style="font-weight:700;margin-top:1rem;">{{ section.settings.account_heading | default: 'Check your account' }}</p>
        <p class="text-muted" style="margin-top:0.4rem;">{{ section.settings.account_text | default: 'Log in to see order status and tracking links for every order.' }}</p>
        <a href="{{ routes.account_login_url }}" class="btn btn--secondary" style="margin-top:1.25rem;">{{ 'customer.log_in.sign_in' | t }}</a>
      </div>
      <div class="card card--pad" style="text-align:center;">
        <span class="benefit-list__icon" style="background:var(--cs-card);margin-inline:auto;">{%- render 'icon', name: 'mail', size: 22 -%}</span>
        <p style="font-weight:700;margin-top:1rem;">{{ section.settings.email_heading | default: 'Check your inbox' }}</p>
        <p class="text-muted" style="margin-top:0.4rem;">{{ section.settings.email_text | default: 'Your shipping confirmation email contains a direct tracking link for your order.' }}</p>
        <a href="{{ section.settings.contact_link | default: '/pages/contact' }}" class="btn btn--secondary" style="margin-top:1.25rem;">{{ section.settings.contact_label | default: "Can't find it? Contact us" }}</a>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Order tracking",
  "tag": "section",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-paper" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Order status" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Track your order" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>There are two quick ways to check on your Table Buddy order.</p>" },
    { "type": "text", "id": "account_heading", "label": "Account card heading", "default": "Check your account" },
    { "type": "textarea", "id": "account_text", "label": "Account card text", "default": "Log in to see order status and tracking links for every order." },
    { "type": "text", "id": "email_heading", "label": "Email card heading", "default": "Check your inbox" },
    { "type": "textarea", "id": "email_text", "label": "Email card text", "default": "Your shipping confirmation email contains a direct tracking link for your order." },
    { "type": "url", "id": "contact_link", "label": "Contact link" },
    { "type": "text", "id": "contact_label", "label": "Contact button label", "default": "Can't find it? Contact us" }
  ],
  "presets": [
    { "name": "Order tracking" }
  ]
}
{% endschema %}
