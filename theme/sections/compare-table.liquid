<div class="color-{{ section.settings.color_scheme }}">
  <div class="page-width section">
    <div class="section-header section-header--center">
      <p class="eyebrow">{{ section.settings.eyebrow }}</p>
      <h2 class="h2">{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}<p class="text-muted">{{ section.settings.text }}</p>{%- endif -%}
    </div>

    <div class="tb-table-wrap">
      <table class="tb-table">
        <thead>
          <tr>
            <th scope="col"></th>
            {%- for block in section.blocks -%}
              {%- liquid
                assign col_image = block.settings.image
                if col_image == blank and block.settings.product != blank
                  assign col_image = block.settings.product.featured_image
                endif
              -%}
              <th scope="col" style="text-align:center;">
                {%- if col_image != blank -%}
                  <img src="{{ col_image | image_url: width: 200 }}" alt="{{ block.settings.name | escape }}" loading="lazy" width="110" height="110" style="margin-inline:auto;object-fit:contain;border-radius:12px;">
                {%- else -%}
                  <span class="compare-table__badge" aria-hidden="true">{{ block.settings.name | slice: 0, 1 }}</span>
                {%- endif -%}
                <div class="compare-table__name">{{ block.settings.name }}</div>
                {%- if block.settings.product != blank -%}
                  <a href="{{ block.settings.product.url }}" class="btn btn--primary btn--sm" style="margin-top:0.6rem;">{{ 'products.product.view_details' | t }}</a>
                {%- endif -%}
              </th>
            {%- endfor -%}
          </tr>
        </thead>
        <tbody>
          <tr>
            <th scope="row">{{ 'products.product.price' | t }}</th>
            {%- for block in section.blocks -%}
              <td style="text-align:center;font-weight:700;">
                {%- if block.settings.product != blank and block.settings.product.price_varies -%}
                  {{ 'products.product.price_from' | t }} {{ block.settings.product.price_min | money }}
                {%- elsif block.settings.product != blank -%}
                  {{ block.settings.product.price | money }}
                {%- else -%}
                  {{ block.settings.price_text }}
                {%- endif -%}
              </td>
            {%- endfor -%}
          </tr>
          <tr>
            <th scope="row">Height positions</th>
            {%- for block in section.blocks -%}<td style="text-align:center;">{{ block.settings.height_positions }}</td>{%- endfor -%}
          </tr>
          <tr>
            <th scope="row">Tabletop angles</th>
            {%- for block in section.blocks -%}<td style="text-align:center;">{{ block.settings.angles }}</td>{%- endfor -%}
          </tr>
          <tr>
            <th scope="row">Cup holder</th>
            {%- for block in section.blocks -%}
              <td style="text-align:center;">{% if block.settings.cup_holder %}{%- render 'icon', name: 'check', size: 18 -%}{% else %}—{% endif %}</td>
            {%- endfor -%}
          </tr>
          <tr>
            <th scope="row">Detachable footrest</th>
            {%- for block in section.blocks -%}
              <td style="text-align:center;">{% if block.settings.footrest %}{%- render 'icon', name: 'check', size: 18 -%}{% else %}—{% endif %}</td>
            {%- endfor -%}
          </tr>
          <tr>
            <th scope="row">Colours available</th>
            {%- for block in section.blocks -%}
              {%- liquid
                assign colour_option = blank
                if block.settings.product != blank
                  assign colour_option = block.settings.product.options_by_name['Color']
                  if colour_option == blank
                    assign colour_option = block.settings.product.options_by_name['Colour']
                  endif
                endif
              -%}
              <td style="text-align:center;">
                {%- if colour_option != blank -%}
                  <div class="compare-table__swatches">
                    {%- for value in colour_option.values -%}
                      {%- render 'swatch', value: value, size: 16, interactive: false -%}
                    {%- endfor -%}
                  </div>
                {%- else -%}
                  {{ block.settings.colours }}
                {%- endif -%}
              </td>
            {%- endfor -%}
          </tr>
          <tr>
            <th scope="row">Folded size</th>
            {%- for block in section.blocks -%}<td style="text-align:center;">{{ block.settings.folded_size | default: '—' }}</td>{%- endfor -%}
          </tr>
          <tr>
            <th scope="row">Warranty</th>
            {%- for block in section.blocks -%}<td style="text-align:center;">{{ block.settings.warranty | default: '—' }}</td>{%- endfor -%}
          </tr>
        </tbody>
      </table>
    </div>

    {%- if section.settings.show_trust_row -%}
      <div class="compare-trust">
        <span class="compare-trust__item">{%- render 'icon', name: 'truck', size: 20 -%} {{ section.settings.trust_shipping | default: 'Fast Australia-wide shipping' }}</span>
        <span class="compare-trust__item">{%- render 'icon', name: 'shield', size: 20 -%} {{ section.settings.trust_guarantee | default: '30-day money-back guarantee' }}</span>
        <span class="compare-trust__item">{%- render 'icon', name: 'refresh', size: 20 -%} {{ section.settings.trust_warranty | default: '12-month warranty' }}</span>
      </div>
    {%- endif -%}

    {%- if section.settings.button_label != blank -%}
      <div class="flex-center" style="margin-top:2rem;">
        <a href="{{ section.settings.button_link | default: '#' }}" class="btn btn--primary">{{ section.settings.button_label }}</a>
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Compare models",
  "tag": "section",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-paper" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Compare models" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Find the right Table Buddy for you" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Compare features and pricing to choose the model that's right for your routine." },
    { "type": "checkbox", "id": "show_trust_row", "label": "Show trust row", "default": true },
    { "type": "text", "id": "trust_shipping", "label": "Trust item 1", "default": "Fast Australia-wide shipping" },
    { "type": "text", "id": "trust_guarantee", "label": "Trust item 2", "default": "30-day money-back guarantee" },
    { "type": "text", "id": "trust_warranty", "label": "Trust item 3", "default": "12-month warranty" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop all Table Buddy" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "blocks": [
    {
      "type": "model",
      "name": "Model column",
      "settings": [
        { "type": "product", "id": "product", "label": "Linked product", "info": "Link the real product to auto-fill this column's image, price and colour swatches from Shopify." },
        { "type": "image_picker", "id": "image", "label": "Image override" },
        { "type": "text", "id": "name", "label": "Name", "default": "Table Buddy Regular" },
        { "type": "text", "id": "price_text", "label": "Price (text)", "info": "Enter manually, e.g. $79. Configure the real price on the linked product / Shopify admin.", "default": "$—" },
        { "type": "text", "id": "height_positions", "label": "Height positions", "default": "6" },
        { "type": "text", "id": "angles", "label": "Tabletop angles", "default": "3" },
        { "type": "checkbox", "id": "cup_holder", "label": "Has cup holder", "default": false },
        { "type": "checkbox", "id": "footrest", "label": "Has detachable footrest", "default": false },
        { "type": "text", "id": "colours", "label": "Colours available", "default": "9" },
        { "type": "text", "id": "folded_size", "label": "Folded size", "info": "Add once confirmed — required info." },
        { "type": "text", "id": "warranty", "label": "Warranty", "info": "Add once confirmed — required info." }
      ]
    }
  ],
  "max_blocks": 3,
  "presets": [
    {
      "name": "Compare models",
      "blocks": [
        { "type": "model", "settings": { "name": "Table Buddy Regular", "cup_holder": false, "footrest": false } },
        { "type": "model", "settings": { "name": "Table Buddy Smart", "cup_holder": true, "footrest": false } },
        { "type": "model", "settings": { "name": "Table Buddy Executive", "cup_holder": true, "footrest": true } }
      ]
    }
  ]
}
{% endschema %}
