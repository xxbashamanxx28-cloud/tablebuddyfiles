<div class="color-{{ section.settings.color_scheme }}">
  <div class="page-width section {% if section.settings.narrow %}section--tight{% endif %}">
    <div class="rich-text {% if section.settings.center %}rich-text--center{% endif %}" {% unless section.settings.center %}style="max-width:{{ section.settings.max_width }}px;"{% endunless %}>
      {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      {%- if section.settings.heading != blank -%}<h1 class="h1" style="margin-bottom:1rem;">{{ section.settings.heading }}</h1>{%- endif -%}
      {%- if section.settings.text != blank -%}<div class="prose">{{ section.settings.text }}</div>{%- endif -%}
      {%- if section.settings.button_label != blank -%}
        <a href="{{ section.settings.button_link | default: '#' }}" class="btn btn--primary" style="margin-top:1.5rem;">{{ section.settings.button_label }}</a>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Rich text",
  "tag": "section",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-paper" },
    { "type": "checkbox", "id": "narrow", "label": "Reduce spacing", "default": false },
    { "type": "checkbox", "id": "center", "label": "Center content", "default": false },
    { "type": "range", "id": "max_width", "label": "Max width", "min": 480, "max": 900, "step": 20, "default": 760, "unit": "px" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "text", "id": "button_label", "label": "Button label" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "presets": [
    { "name": "Rich text" }
  ]
}
{% endschema %}
