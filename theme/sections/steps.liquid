<div class="color-{{ section.settings.color_scheme }}">
  <div class="page-width section {% if section.settings.narrow %}section--tight{% endif %}">
    <div class="section-header section-header--center">
      <p class="eyebrow">{{ section.settings.eyebrow }}</p>
      <h2 class="h2">{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}<p class="text-muted" style="max-width:60ch;margin-inline:auto;margin-top:0.5rem;">{{ section.settings.text }}</p>{%- endif -%}
    </div>
    <div class="step-list">
      {%- for block in section.blocks -%}
        <div class="step-list__item" {{ block.shopify_attributes }}>
          <span class="step-list__number"></span>
          {%- if block.settings.image != blank -%}
            <img src="{{ block.settings.image | image_url: width: 400 }}" alt="{{ block.settings.title | escape }}" loading="lazy" width="200" height="150" style="border-radius:14px;object-fit:cover;aspect-ratio:4/3;">
          {%- endif -%}
          <p style="font-weight:700;">{{ block.settings.title }}</p>
          {%- if block.settings.text != blank -%}<p class="text-muted" style="font-size:0.9rem;">{{ block.settings.text }}</p>{%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Steps",
  "tag": "section",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-paper" },
    { "type": "checkbox", "id": "narrow", "label": "Reduce spacing", "default": false },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "How to use" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Set up in under a minute" },
    { "type": "textarea", "id": "text", "label": "Text" }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "title", "label": "Title", "default": "Unfold the legs" },
        { "type": "textarea", "id": "text", "label": "Text" }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Steps",
      "blocks": [
        { "type": "step", "settings": { "title": "Unfold the legs", "text": "Release the folded legs and stand the frame upright." } },
        { "type": "step", "settings": { "title": "Pick your height", "text": "Slide to one of six height positions and lock it in." } },
        { "type": "step", "settings": { "title": "Set your angle", "text": "Choose flat, reading or hobby angle for the tabletop." } },
        { "type": "step", "settings": { "title": "Position it", "text": "Slide it over the sofa, bed or chair — no assembly required." } }
      ]
    }
  ]
}
{% endschema %}
