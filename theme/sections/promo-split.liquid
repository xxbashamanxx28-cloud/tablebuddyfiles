<div class="page-width section section--tight">
  <div class="promo-split color-{{ section.settings.color_scheme }}" data-media-side="{{ section.settings.media_side }}">
    <div class="promo-split__content">
      <p class="eyebrow">{{ section.settings.eyebrow }}</p>
      <h2 class="h2 text-balance">{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}<div class="prose">{{ section.settings.text }}</div>{%- endif -%}
      <div class="flex gap-md" style="flex-wrap:wrap;">
        {%- if section.settings.button_label != blank -%}
          <a href="{{ section.settings.button_link | default: '#' }}" class="btn btn--primary">{{ section.settings.button_label }}</a>
        {%- endif -%}
      </div>
    </div>
    <div class="promo-split__media">
      {%- if section.settings.image != blank -%}
        <img src="{{ section.settings.image | image_url: width: 900 }}" alt="{{ section.settings.heading | escape }}" loading="lazy" width="900" height="700">
      {%- else -%}
        <img src="{{ 'lifestyle-regular-white-sofa-plant-01.jpg' | asset_url }}" alt="{{ section.settings.heading | escape }}" loading="lazy" width="900" height="700">
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Promo split",
  "tag": "section",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-sky" },
    { "type": "select", "id": "media_side", "label": "Image position", "options": [
      { "value": "right", "label": "Right" }, { "value": "left", "label": "Left" }
    ], "default": "right" },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "A bundle of favourites" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The whole setup" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Everything you need for working, snacking and unwinding — bundled and ready to fold away.</p>" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop bundles" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "presets": [
    { "name": "Promo split" }
  ]
}
{% endschema %}
