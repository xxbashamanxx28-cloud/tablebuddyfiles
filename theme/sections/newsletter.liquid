<div class="color-{{ section.settings.color_scheme }}">
  <div class="page-width section section--tight">
    <div class="newsletter-section">
      <p class="eyebrow">{{ section.settings.eyebrow | default: 'Stay connected' }}</p>
      <h2 class="h2">{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}<div class="prose text-balance" style="max-width:44ch;margin-inline:auto;">{{ section.settings.text }}</div>{%- endif -%}

      {%- form 'customer', id: 'newsletter-form', class: 'newsletter-form' -%}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <input type="hidden" name="contact[accepts_marketing]" value="true">
        <label class="visually-hidden" for="newsletter-email">{{ 'general.newsletter.placeholder' | t }}</label>
        <input type="email" id="newsletter-email" name="contact[email]" class="input" required placeholder="{{ 'general.newsletter.placeholder' | t }}" value="{{ form.email }}">
        <button type="submit" class="btn btn--primary">{{ 'general.newsletter.submit' | t }}</button>
        {%- if form.posted_successfully? -%}
          <p style="width:100%;margin-top:0.5rem;">{{ 'general.newsletter.success' | t }}</p>
        {%- endif -%}
      {%- endform -%}
      <p class="text-muted" style="font-size:0.8rem;margin-top:1rem;">{{ 'general.newsletter.consent' | t }}</p>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Newsletter",
  "tag": "section",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-navy" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Stay connected" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Stay in the loop" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>New heights, new bundles, real customer wins — straight to your inbox.</p>" }
  ],
  "presets": [
    { "name": "Newsletter" }
  ]
}
{% endschema %}
