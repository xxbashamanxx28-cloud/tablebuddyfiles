<div class="color-{{ section.settings.color_scheme }}">
  <div class="page-width section {% if section.settings.narrow %}section--tight{% endif %}">
    {%- if section.settings.heading != blank -%}
      <div class="section-header {% if section.settings.center_header %}section-header--center{% endif %}">
        <p class="eyebrow">{{ section.settings.eyebrow }}</p>
        <h2 class="h2">{{ section.settings.heading }}</h2>
        {%- if section.settings.text != blank -%}<p class="text-muted" style="margin-top:0.5rem;max-width:60ch;{% if section.settings.center_header %}margin-inline:auto;{% endif %}">{{ section.settings.text }}</p>{%- endif -%}
      </div>
    {%- endif -%}
    <div class="grid grid--4">
      {%- for block in section.blocks -%}
        {%- liquid
          assign card_title = block.settings.title
          assign card_url = block.settings.link
          assign card_image = block.settings.image
          if block.settings.collection != blank
            assign card_title = card_title | default: block.settings.collection.title
            assign card_url = card_url | default: block.settings.collection.url
            assign card_image = card_image | default: block.settings.collection.featured_image
          endif
        -%}
        <a href="{{ card_url | default: '#' }}" class="card" style="overflow:hidden;text-decoration:none;" {{ block.shopify_attributes }}>
          <div style="aspect-ratio:4/3;background:var(--cs-card,#EEF4FB);overflow:hidden;">
            {%- if card_image != blank -%}
              <img src="{{ card_image | image_url: width: 500 }}" alt="{{ card_title | escape }}" loading="lazy" width="500" height="375" style="width:100%;height:100%;object-fit:cover;">
            {%- else -%}
              <img src="{{ 'lifestyle-regular-skyblue-sofa-mug-01.png' | asset_url }}" alt="{{ card_title | escape }}" loading="lazy" width="500" height="375" style="width:100%;height:100%;object-fit:cover;">
            {%- endif -%}
          </div>
          <div style="padding:1.1rem 1.25rem;">
            <p style="font-weight:700;">{{ card_title | default: '[ Add title ]' }}</p>
            {%- if block.settings.subtitle != blank -%}<p class="text-muted" style="font-size:0.85rem;margin-top:0.2rem;">{{ block.settings.subtitle }}</p>{%- endif -%}
          </div>
        </a>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Collection list",
  "tag": "section",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-paper" },
    { "type": "checkbox", "id": "narrow", "label": "Reduce spacing", "default": false },
    { "type": "checkbox", "id": "center_header", "label": "Center heading", "default": true },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "textarea", "id": "text", "label": "Text" }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Card",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection (optional)", "info": "Auto-fills title, link and image if set — override any field below." },
        { "type": "image_picker", "id": "image", "label": "Image override" },
        { "type": "text", "id": "title", "label": "Title override" },
        { "type": "text", "id": "subtitle", "label": "Subtitle" },
        { "type": "url", "id": "link", "label": "Link override" }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "Collection list",
      "blocks": [
        { "type": "card" }, { "type": "card" }, { "type": "card" }, { "type": "card" }
      ]
    }
  ]
}
{% endschema %}
