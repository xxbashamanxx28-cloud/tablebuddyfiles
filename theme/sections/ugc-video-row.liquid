<div class="color-{{ section.settings.color_scheme }}">
  <div class="page-width section section--tight">
    <div class="section-header section-header--center">
      <p class="eyebrow">{{ section.settings.eyebrow | default: 'Real Table Buddy owners' }}</p>
      <h2 class="h2">{{ section.settings.heading | default: 'From our customers to your couch' }}</h2>
    </div>
    <div class="carousel" data-carousel>
      <div class="ugc-row__track carousel__track">
        {%- for block in section.blocks -%}
          <div class="ugc-item" {{ block.shopify_attributes }}>
            {%- if block.settings.video != blank -%}
              <video src="{{ block.settings.video }}" muted loop playsinline preload="none" poster="{% if block.settings.thumbnail %}{{ block.settings.thumbnail | image_url: width: 400 }}{% endif %}"></video>
            {%- elsif block.settings.thumbnail != blank -%}
              <img src="{{ block.settings.thumbnail | image_url: width: 400 }}" alt="{{ block.settings.caption | escape }}" loading="lazy" width="200" height="356">
            {%- else -%}
              <div class="flex-center" style="width:100%;height:100%;padding:1rem;text-align:center;color:#fff;font-size:0.75rem;line-height:1.4;">
                [ Placeholder — upload UGC clip.{% if block.settings.generation_prompt != blank %} Suggested video-generator prompt in theme editor. {% endif %}]
              </div>
            {%- endif -%}
            <span class="ugc-item__play"><span>{%- render 'icon', name: 'play', size: 20 -%}</span></span>
            {%- if block.settings.caption != blank -%}<span class="ugc-item__caption">{{ block.settings.caption }}</span>{%- endif -%}
          </div>
        {%- endfor -%}
      </div>
      <div class="carousel__nav" style="justify-content:center;margin-top:1.25rem;">
        <button type="button" data-carousel-prev aria-label="Previous">{%- render 'icon', name: 'chevron-left', size: 18 -%}</button>
        <button type="button" data-carousel-next aria-label="Next">{%- render 'icon', name: 'chevron-right', size: 18 -%}</button>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "UGC video row",
  "tag": "section",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-paper" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Real Table Buddy owners" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "From our customers to your couch" }
  ],
  "blocks": [
    {
      "type": "video",
      "name": "UGC clip",
      "settings": [
        { "type": "image_picker", "id": "thumbnail", "label": "Thumbnail / poster image" },
        { "type": "video_url", "id": "video", "label": "Video URL (MP4, hosted or Shopify file)", "accept": ["mp4"] },
        { "type": "text", "id": "caption", "label": "Caption", "default": "@customer_handle" },
        {
          "type": "textarea",
          "id": "generation_prompt",
          "label": "AI video-generator prompt (internal note)",
          "info": "Not shown to customers. Paste into Sora, Runway or similar to generate a placeholder UGC clip until a real customer video is filmed.",
          "default": "Vertical 9:16 selfie-style video, natural phone lighting, a person sitting on a beige sofa with a black Table Buddy adjustable folding table set up over their lap, laptop open on it, casually talking to camera about how easy it was to set up with no tools, warm candid home environment, 8 seconds, UGC testimonial style."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "UGC video row",
      "blocks": [
        { "type": "video", "settings": { "caption": "@homeoffice_hayley" } },
        { "type": "video", "settings": { "caption": "@studywithsam" } },
        { "type": "video", "settings": { "caption": "@gamernightsau" } },
        { "type": "video", "settings": { "caption": "@thefoldeddesk" } },
        { "type": "video", "settings": { "caption": "@couchworkerco" } },
        { "type": "video", "settings": { "caption": "@snacktablediaries" } }
      ]
    }
  ]
}
{% endschema %}
