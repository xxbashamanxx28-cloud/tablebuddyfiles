<div class="color-{{ section.settings.color_scheme }}">
  <div class="page-width section section--tight">
    <div class="section-header section-header--center">
      <p class="eyebrow">{{ section.settings.eyebrow }}</p>
      <h2 class="h2">{{ section.settings.heading }}</h2>
      {%- if section.settings.handle != blank -%}
        <a href="{{ section.settings.handle_link | default: settings.social_instagram }}" class="link-arrow" style="justify-content:center;margin-top:0.5rem;">
          {%- render 'icon', name: 'instagram', size: 18 -%} {{ section.settings.handle }}
        </a>
      {%- endif -%}
    </div>
    <div class="social-gallery__grid">
      {%- for block in section.blocks -%}
        <a href="{{ block.settings.link | default: settings.social_instagram }}" class="social-gallery__item" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            <img src="{{ block.settings.image | image_url: width: 400 }}" alt="{{ block.settings.alt | escape }}" loading="lazy" width="300" height="300">
          {%- endif -%}
          <span class="icon-btn"><span aria-hidden="true">{%- render 'icon', name: 'instagram', size: 16 -%}</span></span>
        </a>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Social gallery",
  "tag": "section",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-paper" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Tag us" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Let's be social" },
    { "type": "text", "id": "handle", "label": "Handle text", "default": "@tablebuddy" },
    { "type": "url", "id": "handle_link", "label": "Handle link" }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Photo",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "alt", "label": "Alt text" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "max_blocks": 10,
  "presets": [
    {
      "name": "Social gallery",
      "blocks": [
        { "type": "image" }, { "type": "image" }, { "type": "image" }, { "type": "image" }, { "type": "image" }
      ]
    }
  ]
}
{% endschema %}
