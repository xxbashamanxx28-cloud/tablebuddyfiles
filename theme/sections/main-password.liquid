<div class="color-{{ section.settings.color_scheme }}" style="width:100%;min-height:100vh;display:flex;align-items:center;">
  <div class="page-width" style="max-width:520px;text-align:center;margin-inline:auto;">
    {%- if settings.logo != blank -%}
      <img src="{{ settings.logo | image_url: width: 220 }}" alt="{{ shop.name }}" width="160" style="margin:0 auto 2rem;">
    {%- else -%}
      <p class="site-header__logo-text" style="font-size:1.8rem;margin-bottom:2rem;">{{ shop.name }}</p>
    {%- endif -%}

    <h1 class="h1">{{ section.settings.heading }}</h1>
    <p style="opacity:0.85;margin-top:0.75rem;max-width:44ch;margin-inline:auto;">{{ section.settings.text }}</p>

    {%- if shop.password_message != blank -%}
      <p style="color:#F5A623;margin-top:1rem;">{{ shop.password_message }}</p>
    {%- endif -%}

    <div class="card card--pad" style="background:var(--cs-card,#fff);margin-top:2rem;">
      {%- form 'storefront_password' -%}
        {%- if form.errors -%}
          <p role="alert" style="color:#C0362C;margin-bottom:1rem;">{{ 'general.password_page.login_form_error' | t }}</p>
        {%- endif -%}
        <div class="field">
          <label for="password" class="visually-hidden">{{ 'general.password_page.login_form_password_label' | t }}</label>
          <input type="password" id="password" name="password" class="input" placeholder="{{ 'general.password_page.login_form_password_label' | t }}">
        </div>
        <button type="submit" class="btn btn--primary btn--block" style="margin-top:1rem;">{{ 'general.password_page.login_password_button' | t }}</button>
      {%- endform -%}
    </div>

    {%- if section.settings.show_newsletter -%}
      {%- form 'customer', id: 'password-newsletter', class: 'newsletter-form' -%}
        <input type="hidden" name="contact[tags]" value="newsletter,password-page">
        <label class="visually-hidden" for="password-email">Email</label>
        <input type="email" id="password-email" name="contact[email]" class="input" required placeholder="{{ 'general.newsletter.placeholder' | t }}">
        <button type="submit" class="btn btn--secondary">{{ 'general.newsletter.submit' | t }}</button>
        {%- if form.posted_successfully? -%}<p style="width:100%;margin-top:0.5rem;">{{ 'general.newsletter.success' | t }}</p>{%- endif -%}
      {%- endform -%}
    {%- endif -%}

    <p style="margin-top:2rem;opacity:0.7;font-size:0.85rem;">{{ 'general.password_page.admin_link_html' | t }}</p>
  </div>
</div>

{% schema %}
{
  "name": "Password page",
  "tag": "section",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-navy" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "We're almost ready" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Table Buddy is putting the finishing touches on the store. Enter the password below if you have early access, or leave your email and we'll let you know the moment we launch.</p>" },
    { "type": "checkbox", "id": "show_newsletter", "label": "Show newsletter signup", "default": true }
  ]
}
{% endschema %}
