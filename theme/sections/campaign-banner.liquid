<div class="page-width section section--tight">
  <div class="campaign-banner color-{{ section.settings.color_scheme }}">
    <div class="campaign-banner__media">
      {%- if section.settings.image_left != blank -%}
        <img src="{{ section.settings.image_left | image_url: width: 400 }}" alt="" loading="lazy" width="220" height="220">
      {%- else -%}
        <img src="{{ 'product-regular-red-studio-01.jpg' | asset_url }}" alt="" loading="lazy" width="220" height="220">
      {%- endif -%}
    </div>
    <div class="campaign-banner__content">
      <h2 class="h2 text-balance">{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}<p style="max-width:46ch;">{{ section.settings.text }}</p>{%- endif -%}
      {%- if section.settings.button_label != blank -%}
        <a href="{{ section.settings.button_link | default: '#' }}" class="btn btn--secondary">{{ section.settings.button_label }}</a>
      {%- endif -%}
    </div>
    <div class="campaign-banner__media">
      {%- if section.settings.image_right != blank -%}
        <img src="{{ section.settings.image_right | image_url: width: 400 }}" alt="" loading="lazy" width="220" height="220">
      {%- else -%}
        <img src="{{ 'product-regular-mandala-studio-01.jpg' | asset_url }}" alt="" loading="lazy" width="220" height="220">
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Campaign banner",
  "tag": "section",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-aqua" },
    { "type": "image_picker", "id": "image_left", "label": "Left image" },
    { "type": "image_picker", "id": "image_right", "label": "Right image" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Upgrade your everyday setup" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "New colours and accessories added regularly." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop now" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "presets": [
    { "name": "Campaign banner" }
  ]
}
{% endschema %}
