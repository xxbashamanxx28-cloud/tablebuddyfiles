<div class="color-{{ section.settings.color_scheme }}">
  <div class="page-width section" style="text-align:center;">
    <img src="{{ 'product-regular-mandala-studio-01.png' | asset_url }}" alt="" width="180" height="180" style="margin:0 auto 2rem;object-fit:contain;" loading="eager">
    <p class="eyebrow">404</p>
    <h1 class="h1">{{ 'general.404.title' | t }}</h1>
    <p class="text-muted" style="max-width:48ch;margin:0.75rem auto 0;">{{ 'general.404.subtext' | t }}</p>
    <a href="{{ routes.root_url }}" class="btn btn--primary" style="margin-top:2rem;">{{ 'general.404.link' | t }}</a>
  </div>
</div>

{% schema %}
{
  "name": "404",
  "tag": "section",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-sky" }
  ]
}
{% endschema %}
