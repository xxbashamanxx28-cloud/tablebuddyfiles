<div class="color-{{ section.settings.color_scheme }}">
  <div class="page-width section">
    <div class="section-header section-header--center">
      <p class="eyebrow">{{ section.settings.eyebrow }}</p>
      <h1 class="h1">{{ section.settings.heading }}</h1>
      {%- if section.settings.text != blank -%}<p class="text-muted" style="max-width:60ch;margin-inline:auto;margin-top:0.5rem;">{{ section.settings.text }}</p>{%- endif -%}
    </div>

    <form data-bundle-form style="max-width:880px;margin-inline:auto;">
      {%- assign required_blocks = section.blocks | where: 'type', 'required_choice' -%}
      {%- assign optional_blocks = section.blocks | where: 'type', 'optional_addon' -%}

      {%- if required_blocks.size > 0 -%}
        <p style="font-weight:700;margin-bottom:0.75rem;">1. {{ section.settings.step1_label | default: 'Choose your table' }}</p>
        <div class="grid grid--3" role="radiogroup" aria-label="{{ section.settings.step1_label | default: 'Choose your table' }}">
          {%- for block in required_blocks -%}
            {%- assign p = block.settings.product -%}
            <label class="card card--pad" style="cursor:pointer;text-align:center;" {{ block.shopify_attributes }}>
              <input type="radio" name="bundle-required" class="visually-hidden" data-bundle-item data-required="true" value="{{ p.selected_or_first_available_variant.id }}" {% if forloop.first %}checked{% endif %}>
              {%- if p.featured_image -%}
                <img src="{{ p.featured_image | image_url: width: 300 }}" alt="{{ p.title | escape }}" width="140" height="140" style="margin-inline:auto;object-fit:contain;" loading="lazy">
              {%- endif -%}
              <p style="font-weight:700;margin-top:0.75rem;">{{ p.title | default: '[ Select product in theme editor ]' }}</p>
              {%- if p != blank -%}<div style="margin-top:0.35rem;">{%- render 'price', product: p -%}</div>{%- endif -%}
            </label>
          {%- endfor -%}
        </div>
      {%- endif -%}

      {%- if optional_blocks.size > 0 -%}
        <p style="font-weight:700;margin:2rem 0 0.75rem;">2. {{ section.settings.step2_label | default: 'Add accessories (optional)' }}</p>
        <div class="grid grid--3">
          {%- for block in optional_blocks -%}
            {%- assign p = block.settings.product -%}
            <label class="card card--pad flex gap-sm" style="cursor:pointer;align-items:center;" {{ block.shopify_attributes }}>
              <input type="checkbox" data-bundle-item value="{{ p.selected_or_first_available_variant.id }}">
              {%- if p.featured_image -%}
                <img src="{{ p.featured_image | image_url: width: 120 }}" alt="{{ p.title | escape }}" width="52" height="52" style="object-fit:contain;flex-shrink:0;" loading="lazy">
              {%- endif -%}
              <span>
                <span style="display:block;font-weight:700;">{{ p.title | default: '[ Select product in theme editor ]' }}</span>
                {%- if p != blank -%}<span style="display:block;font-size:0.85rem;">{%- render 'price', product: p -%}</span>{%- endif -%}
              </span>
            </label>
          {%- endfor -%}
        </div>
      {%- endif -%}

      <div class="flex-center" style="margin-top:2.5rem;">
        <button type="submit" class="btn btn--primary">{{ 'products.product.buy_bundle' | t }}</button>
      </div>
      <p class="text-muted" style="text-align:center;margin-top:0.75rem;font-size:0.85rem;">{{ section.settings.disclaimer | default: 'Prices and any bundle savings are calculated at checkout.' }}</p>
    </form>
  </div>
</div>

{% schema %}
{
  "name": "Bundle builder",
  "tag": "section",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-paper" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Create your own bundle" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Build your own bundle" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Start with a table, then add any accessories you'd like — all in one order." },
    { "type": "text", "id": "step1_label", "label": "Step 1 label", "default": "Choose your table" },
    { "type": "text", "id": "step2_label", "label": "Step 2 label", "default": "Add accessories (optional)" },
    { "type": "text", "id": "disclaimer", "label": "Disclaimer text", "default": "Prices and any bundle savings are calculated at checkout." }
  ],
  "blocks": [
    {
      "type": "required_choice",
      "name": "Table option",
      "settings": [
        { "type": "product", "id": "product", "label": "Product" }
      ]
    },
    {
      "type": "optional_addon",
      "name": "Optional add-on",
      "settings": [
        { "type": "product", "id": "product", "label": "Product", "info": "Only add real, available products — do not reference accessories that don't exist yet." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Bundle builder",
      "blocks": [
        { "type": "required_choice" },
        { "type": "required_choice" },
        { "type": "required_choice" }
      ]
    }
  ]
}
{% endschema %}
