<div class="page-width section section--tight">
  <div class="benefit-split color-{{ section.settings.color_scheme }}">
    <div class="benefit-split__media">
      {%- if section.settings.video != blank -%}
        <video src="{{ section.settings.video }}" muted loop playsinline preload="none" poster="{% if section.settings.image %}{{ section.settings.image | image_url: width: 900 }}{% endif %}"></video>
        <span class="benefit-split__play"><span>{%- render 'icon', name: 'play', size: 26 -%}</span></span>
      {%- elsif section.settings.image != blank -%}
        <img src="{{ section.settings.image | image_url: width: 900 }}" alt="{{ section.settings.heading | escape }}" loading="lazy" width="900" height="700">
      {%- else -%}
        <img src="{{ 'lifestyle-regular-mandala-sofa-laptop-01.png' | asset_url }}" alt="{{ section.settings.heading | escape }}" loading="lazy" width="900" height="700">
      {%- endif -%}
    </div>
    <div class="benefit-split__content">
      <p class="eyebrow">{{ section.settings.eyebrow }}</p>
      <h2 class="h2 text-balance">{{ section.settings.heading }}</h2>
      <div class="benefit-list">
        {%- for block in section.blocks -%}
          <div class="benefit-list__item" {{ block.shopify_attributes }}>
            <span class="benefit-list__icon">{%- render 'icon', name: block.settings.icon, size: 22 -%}</span>
            <div>
              <p style="font-weight:700;">{{ block.settings.title }}</p>
              {%- if block.settings.text != blank -%}<p class="text-muted" style="margin-top:0.2rem;">{{ block.settings.text }}</p>{%- endif -%}
            </div>
          </div>
        {%- endfor -%}
      </div>
      {%- if section.settings.button_label != blank -%}
        <a href="{{ section.settings.button_link | default: '#' }}" class="btn btn--primary" style="align-self:flex-start;">{{ section.settings.button_label }}</a>
      {%- endif -%}
      {%- if section.settings.guarantee_text != blank -%}
        <p style="font-size:0.8rem;opacity:0.8;">{{ section.settings.guarantee_text }}</p>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Benefit split",
  "tag": "section",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-navy" },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "video_url", "id": "video", "label": "Video URL (optional, overrides image)", "accept": ["mp4"] },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Why Table Buddy" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Built to adjust to you, not the other way around" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop Table Buddy" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "text", "id": "guarantee_text", "label": "Fine print", "default": "30-day money-back guarantee on every order" }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit",
      "settings": [
        { "type": "select", "id": "icon", "label": "Icon", "options": [
          { "value": "height", "label": "Height" },
          { "value": "angle", "label": "Angle" },
          { "value": "fold", "label": "Fold" },
          { "value": "no-tools", "label": "No tools" },
          { "value": "cupholder", "label": "Cup holder" },
          { "value": "footrest", "label": "Footrest" },
          { "value": "portable", "label": "Portable" }
        ], "default": "height" },
        { "type": "text", "id": "title", "label": "Title", "default": "Six height positions" },
        { "type": "textarea", "id": "text", "label": "Text" }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "Benefit split",
      "blocks": [
        { "type": "benefit", "settings": { "icon": "height", "title": "Six height positions", "text": "From sofa-side snacking height to standing desk height, adjust in seconds." } },
        { "type": "benefit", "settings": { "icon": "angle", "title": "Three tabletop angles", "text": "Flat for eating and gaming, tilted for reading, writing and hobbies." } },
        { "type": "benefit", "settings": { "icon": "no-tools", "title": "No-tool setup", "text": "Unfold, click the legs into place, and you're done — no screws, no manual." } }
      ]
    }
  ]
}
{% endschema %}
