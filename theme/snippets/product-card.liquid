{%- comment -%} Accepts: product, image_ratio {%- endcomment -%}
{%- liquid
  assign ratio = image_ratio | default: settings.product_image_ratio
  assign rating = product.metafields.reviews.rating.value
  assign rating_count = product.metafields.reviews.rating_count.value
-%}
<div class="product-card">
  {%- if settings.show_quick_add and product.available -%}
    <tb-product-form class="product-card__quick-add">
      {%- assign qv = product.selected_or_first_available_variant -%}
      <form data-type="add-to-cart-form">
        <input type="hidden" name="id" value="{{ qv.id }}" data-variant-id-input>
        <script type="application/json" data-product-json>{{ product.variants | json }}</script>
        <button type="submit" class="btn btn--primary btn--sm" data-submit-button
          data-add-text="{{ 'products.product.quick_add' | t }}"
          data-soldout-text="{{ 'products.product.sold_out' | t }}"
          data-unavailable-text="{{ 'products.product.unavailable' | t }}">
          {{ 'products.product.quick_add' | t }}
        </button>
      </form>
    </tb-product-form>
  {%- endif -%}

  <a href="{{ product.url }}" class="product-card__link">
    <div class="product-card__media" data-ratio="{{ ratio }}">
      <div class="product-card__badges">
        {%- if product.compare_at_price > product.price -%}<span class="badge">{{ settings.badge_sale_text }}</span>{%- endif -%}
        {%- if product.metafields.custom.bestseller -%}<span class="badge">{{ settings.badge_bestseller_text }}</span>{%- endif -%}
      </div>
      {%- if product.featured_image -%}
        <img
          src="{{ product.featured_image | image_url: width: 600 }}"
          srcset="{{ product.featured_image | image_url: width: 300 }} 300w, {{ product.featured_image | image_url: width: 600 }} 600w, {{ product.featured_image | image_url: width: 900 }} 900w"
          sizes="(min-width: 990px) 25vw, (min-width: 750px) 33vw, 50vw"
          alt="{{ product.featured_image.alt | escape }}"
          width="{{ product.featured_image.width }}" height="{{ product.featured_image.height }}"
          loading="lazy">
        {%- if product.images.size > 1 -%}
          <img class="is-secondary" src="{{ product.images[1] | image_url: width: 600 }}" alt="" loading="lazy" width="600" height="600">
        {%- endif -%}
      {%- endif -%}
    </div>
    <div class="product-card__body">
      {%- if settings.show_vendor -%}<span class="product-card__vendor">{{ product.vendor }}</span>{%- endif -%}
      <h3 class="product-card__title">{{ product.title }}</h3>
      {%- if settings.show_rating and rating -%}
        {%- render 'star-rating', rating: rating.rating, count: rating_count -%}
      {%- endif -%}
      {%- render 'price', product: product, show_from: true -%}
      {%- if settings.show_color_swatches and product.options_by_name['Color'] -%}
        <div class="product-card__swatches">
          {%- for value in product.options_by_name['Color'].values limit: 6 -%}
            {%- render 'swatch', value: value, size: 18, interactive: false -%}
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </a>
</div>
