        "r3": { "type": "review", "settings": { "rating": 4, "quote": "Great for gaming nights — the angled setting is perfect for a controller and the tray doesn't wobble even with a monitor on it.", "author": "Priya K.", "location": "Parramatta, NSW" } },
        "r4": { "type": "review", "settings": { "rating": 5, "quote": "Folds completely flat and slides behind the couch. My apartment is tiny so this mattered more than anything else — genuinely space-saving.", "author": "Josh L.", "location": "Fremantle, WA" } },
