        "r1": { "type": "review", "settings": { "rating": 5, "quote": "I work from the couch three days a week now. Six height settings means it's perfect for my laptop and my lunch plate. Took two minutes to set up, no tools.", "author": "Sarah T.", "location": "Brisbane, QLD" } },
