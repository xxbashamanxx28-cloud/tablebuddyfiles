<div class="color-scheme-paper">
  <div class="page-width section section--tight" style="max-width:480px;">
    <h1 class="h1" style="margin-bottom:2rem;text-align:center;">{{ 'customer.register.title' | t }}</h1>
    {%- form 'create_customer' -%}
      {%- if form.errors -%}
        <p role="alert" style="color:#C0362C;margin-bottom:1rem;">{{ form.errors | default_errors }}</p>
      {%- endif -%}
      <div class="grid grid--2" style="gap:1rem;">
        <div class="field">
          <label for="reg-first-name">{{ 'customer.register.first_name' | t }}</label>
          <input type="text" id="reg-first-name" class="input" name="customer[first_name]" autocomplete="given-name">
        </div>
        <div class="field">
          <label for="reg-last-name">{{ 'customer.register.last_name' | t }}</label>
          <input type="text" id="reg-last-name" class="input" name="customer[last_name]" autocomplete="family-name">
        </div>
      </div>
      <div class="field" style="margin-top:1rem;">
        <label for="reg-email">{{ 'customer.register.email' | t }}</label>
        <input type="email" id="reg-email" class="input" name="customer[email]" autocomplete="email" required>
      </div>
      <div class="field" style="margin-top:1rem;">
        <label for="reg-password">{{ 'customer.register.password' | t }}</label>
        <input type="password" id="reg-password" class="input" name="customer[password]" autocomplete="new-password" required>
      </div>
      <button type="submit" class="btn btn--primary btn--block" style="margin-top:1.5rem;">{{ 'customer.register.submit' | t }}</button>
      <p style="text-align:center;margin-top:1rem;font-size:0.9rem;">
        <a href="{{ routes.account_login_url }}" class="link">{{ 'customer.log_in.sign_in' | t }}</a>
      </p>
    {%- endform -%}
  </div>
</div>
