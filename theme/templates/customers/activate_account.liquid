<div class="color-scheme-paper">
  <div class="page-width section section--tight" style="max-width:440px;">
    <h1 class="h1" style="margin-bottom:0.5rem;text-align:center;">Activate account</h1>
    <p class="text-muted" style="text-align:center;margin-bottom:1.5rem;">Create a password to activate your account.</p>
    {%- form 'activate_customer_password' -%}
      {%- if form.errors -%}
        <p role="alert" style="color:#C0362C;margin-bottom:1rem;">{{ form.errors | default_errors }}</p>
      {%- endif -%}
      <div class="field">
        <label for="activate-password">Password</label>
        <input type="password" id="activate-password" class="input" name="customer[password]" autocomplete="new-password" required>
      </div>
      <div class="field" style="margin-top:1rem;">
        <label for="activate-password-confirm">Confirm password</label>
        <input type="password" id="activate-password-confirm" class="input" name="customer[password_confirmation]" autocomplete="new-password" required>
      </div>
      <button type="submit" class="btn btn--primary btn--block" style="margin-top:1.5rem;">Activate account</button>
      <button type="submit" name="decline" class="btn btn--secondary btn--block" style="margin-top:0.75rem;">Decline invitation</button>
    {%- endform -%}
  </div>
</div>
