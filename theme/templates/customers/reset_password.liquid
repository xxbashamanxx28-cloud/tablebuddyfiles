<div class="color-scheme-paper">
  <div class="page-width section section--tight" style="max-width:440px;">
    <h1 class="h1" style="margin-bottom:0.5rem;text-align:center;">{{ 'customer.reset_password.title' | t }}</h1>
    {%- form 'reset_customer_password' -%}
      {%- if form.errors -%}
        <p role="alert" style="color:#C0362C;margin-bottom:1rem;">{{ form.errors | default_errors }}</p>
      {%- endif -%}
      <div class="field" style="margin-top:1.5rem;">
        <label for="reset-password">{{ 'customer.reset_password.password' | t }}</label>
        <input type="password" id="reset-password" class="input" name="customer[password]" autocomplete="new-password" required>
      </div>
      <div class="field" style="margin-top:1rem;">
        <label for="reset-password-confirm">{{ 'customer.reset_password.password_confirm' | t }}</label>
        <input type="password" id="reset-password-confirm" class="input" name="customer[password_confirmation]" autocomplete="new-password" required>
      </div>
      <button type="submit" class="btn btn--primary btn--block" style="margin-top:1.5rem;">{{ 'customer.reset_password.submit' | t }}</button>
    {%- endform -%}
  </div>
</div>
